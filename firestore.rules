rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check for admin custom claim
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Rules for all submission collections
    match /{collection}/{submissionId}
      where collection in ['research-submissions', 'sponsorship-submissions', 'project-adoption-submissions', 'newsletter-subscriptions'] {

      // Admins can read, write, and delete any document
      allow read, write, delete: if isAdmin();

      // Any authenticated user can create a new submission
      allow create: if request.auth != null;
    }
  }
}
