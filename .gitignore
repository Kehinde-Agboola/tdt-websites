# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for commiting if needed)
.env*

# vercel
.vercel
# typescript
*.tsbuildinfo
next-env.d.ts

# ShopForGood e-commerce folder (temporarily disabled)
# src/app/ShopForGood/

# Local hero video asset is too large for GitHub
public/video.mp4
public/videos.mp4

# Local videos are stored outside git (use Supabase Storage URLs instead)
public/videos/*
!public/videos/.gitkeep
